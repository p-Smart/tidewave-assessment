diff --git a/migrations/004_cleanup_duplicates.sql b/migrations/004_cleanup_duplicates.sql
new file mode 100644
index 0000000..e69de29
--- /dev/null
+++ b/migrations/004_cleanup_duplicates.sql
@@ -0,0 +1,18 @@
+-- Clean up older duplicate leads to prevent clutter in the database
+DELETE FROM leads.lead_activity
+WHERE lead_id IN (
+  SELECT l1.id
+  FROM leads.leads l1
+  JOIN leads.leads l2 ON LOWER(l1.email) = LOWER(l2.email)
+  WHERE l1.created_at < l2.created_at
+);
+
+DELETE FROM leads.leads
+WHERE id IN (
+  SELECT l1.id
+  FROM leads.leads l1
+  JOIN leads.leads l2 ON LOWER(l1.email) = LOWER(l2.email)
+  WHERE l1.created_at < l2.created_at
+);
