    {
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Atomically claim the right to send this message once.\n-- claimed=true  -> this execution owns the send (new key, or the previous attempt 'failed').\n-- claimed=false -> someone else has it; status tells us 'sent' (done) or 'pending' (in flight).\n-- No row at all -> a concurrent claim is still uncommitted: treat as in flight.\nWITH ins AS (\n  INSERT INTO automation.message_claims (dedup_key, workflow, event_id, status)\n  VALUES ($1, $2, $3, 'pending')\n  ON CONFLICT (dedup_key) DO UPDATE\n    SET status = 'pending',\n        attempts = automation.message_claims.attempts + 1,\n        event_id = EXCLUDED.event_id,\n        updated_at = NOW()\n    WHERE automation.message_claims.status = 'failed'\n  RETURNING dedup_key, status, attempts\n)\nSELECT dedup_key, status, attempts, true AS claimed FROM ins\nUNION ALL\nSELECT dedup_key, status, attempts, false AS claimed\n  FROM automation.message_claims\n WHERE dedup_key = $1 AND NOT EXISTS (SELECT 1 FROM ins);",
        "options": {
          "queryReplacement": "={{ [$('Route Decision').first().json.dedupKey, $('Route Decision').first().json.workflow, $('Route Decision').first().json.eventId] }}"
        }
      },
      "name": "Claim Send (idempotency)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1320,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "cred_tidewave_postgres",
          "name": "Tidewave Postgres (automation ledger)"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueErrorOutput"
    },
