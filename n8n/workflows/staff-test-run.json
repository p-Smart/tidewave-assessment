    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Validate the ops console request. Recipient is NOT taken from the request: always staff-test@tidewave.test.\nconst body = $input.first().json.body || {};\nconst errors = [];\nconst templateKey = typeof body.templateKey === 'string' ? body.templateKey.trim() : '';\nif (!/^[a-z0-9][a-z0-9-]{0,63}$/.test(templateKey)) errors.push('templateKey is missing or invalid');\nconst variables = body.variables ?? {};\nif (typeof variables !== 'object' || Array.isArray(variables) || variables === null) errors.push('variables must be an object');\nconst requestId = typeof body.requestId === 'string' && /^[A-Za-z0-9_-]{8,64}$/.test(body.requestId) ? body.requestId : null;\nreturn [{ json: {\n  valid: errors.length === 0,\n  errors,\n  templateKey,\n  variables: errors.length ? {} : variables,\n  requestId,\n  requestedBy: typeof body.requestedBy === 'string' ? body.requestedBy.slice(0, 40) : 'unknown',\n} }];"
      },
      "name": "Validate Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "request-valid?",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Request Valid?",
