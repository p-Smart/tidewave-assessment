        "query": "-- Release the claim so an engine retry / redelivery can try again.\nUPDATE automation.message_claims\n   SET status = 'failed', last_error = $2, updated_at = NOW()\n WHERE dedup_key = $1\nRETURNING dedup_key, status, attempts, last_error;",
        "options": {
