    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE automation.message_claims\n   SET status = 'sent', last_error = NULL, updated_at = NOW()\n WHERE dedup_key = $1\nRETURNING dedup_key, status, attempts;",
        "options": {
